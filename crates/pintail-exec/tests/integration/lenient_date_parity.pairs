Q: SELECT id, d, dt FROM v ORDER BY id;
R: 1	2024-02-30	2024-02-30 10:00:00
R: 2	2024-02-28	2024-02-28 10:00:00
R: 3	2024-04-31	2024-04-31 23:59:59
R: 4	2024-03-01	2024-03-01 00:00:00
R: 5	NULL	NULL
Q: SELECT id FROM v ORDER BY d, id;
R: 5
R: 2
R: 1
R: 4
R: 3
Q: SELECT id FROM v WHERE d IS NULL ORDER BY id;
R: 5
Q: SELECT COUNT(d), COUNT(dt), COUNT(*) FROM v;
R: 4	4	5
Q: SELECT id, YEAR(d), MONTH(d), DAY(d) FROM v ORDER BY id;
R: 1	2024	2	30
R: 2	2024	2	28
R: 3	2024	4	31
R: 4	2024	3	1
R: 5	NULL	NULL	NULL
Q: SELECT id FROM v WHERE d > '2024-02-28' ORDER BY id;
R: 1
R: 3
R: 4
Q: SELECT id FROM v WHERE d BETWEEN '2024-02-01' AND '2024-03-01' ORDER BY id;
R: 1
R: 2
R: 4
Q: SELECT id, d + INTERVAL 1 DAY FROM v ORDER BY id;
R: 1	2024-03-02
R: 2	2024-02-29
R: 3	2024-05-02
R: 4	2024-03-02
R: 5	NULL
Q: SELECT id, DATEDIFF(d, '2024-01-01') FROM v ORDER BY id;
R: 1	60
R: 2	58
R: 3	121
R: 4	60
R: 5	NULL
Q: SELECT id, DATE_FORMAT(d, '%Y/%m/%d') FROM v ORDER BY id;
R: 1	2024/02/30
R: 2	2024/02/28
R: 3	2024/04/31
R: 4	2024/03/01
R: 5	NULL
Q: SELECT id, CAST(d AS CHAR), CONCAT(d, '') FROM v ORDER BY id;
R: 1	2024-02-30	2024-02-30
R: 2	2024-02-28	2024-02-28
R: 3	2024-04-31	2024-04-31
R: 4	2024-03-01	2024-03-01
R: 5	NULL	NULL
Q: SELECT id, d + 0 FROM v ORDER BY id;
R: 1	20240230
R: 2	20240228
R: 3	20240431
R: 4	20240301
R: 5	NULL
Q: SELECT id, DATE(dt), TIME(dt) FROM v ORDER BY id;
R: 1	2024-02-30	10:00:00
R: 2	2024-02-28	10:00:00
R: 3	2024-04-31	23:59:59
R: 4	2024-03-01	00:00:00
