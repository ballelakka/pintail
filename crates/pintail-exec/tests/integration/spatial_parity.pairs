Q: SELECT id, ST_AsText(g), ST_SRID(g), ST_GeometryType(g) FROM s ORDER BY id;
R: 1	LINESTRING(0 0,3 4,6 0)	0	LINESTRING
R: 2	POLYGON((0 0,10 0,10 10,0 10,0 0))	0	POLYGON
R: 3	POLYGON((0 0,10 0,10 10,0 10,0 0))	0	POLYGON
R: 4	POINT(1 2)	4326	POINT
R: 5	LINESTRING(10 20,11 21)	4326	LINESTRING
R: 6	NULL	NULL	NULL
Q: SELECT id, ST_AsText(p), ST_X(p), ST_Y(p), ST_SRID(p) FROM s ORDER BY id;
R: 1	POINT(3 4)	3	4	0
R: 2	POINT(5 5)	5	5	0
R: 3	POINT(15 5)	15	5	0
R: 4	POINT(45 90)	45	90	4326
R: 5	POINT(-33.5 151.25)	-33.5	151.25	4326
R: 6	NULL	NULL	NULL	NULL
Q: SELECT id, HEX(p), HEX(ST_AsBinary(p)), HEX(ST_AsWKB(g)) FROM s ORDER BY id;
R: 1	00000000010100000000000000000008400000000000001040	010100000000000000000008400000000000001040	010200000003000000000000000000000000000000000000000000000000000840000000000000104000000000000018400000000000000000
R: 2	00000000010100000000000000000014400000000000001440	010100000000000000000014400000000000001440	010300000001000000050000000000000000000000000000000000000000000000000024400000000000000000000000000000244000000000000024400000000000000000000000000000244000000000000000000000000000000000
R: 3	0000000001010000000000000000002E400000000000001440	01010000000000000000002E400000000000001440	010300000001000000050000000000000000000000000000000000000000000000000024400000000000000000000000000000244000000000000024400000000000000000000000000000244000000000000000000000000000000000
R: 4	E6100000010100000000000000008056400000000000804640	010100000000000000008046400000000000805640	0101000000000000000000F03F0000000000000040
R: 5	E610000001010000000000000000E862400000000000C040C0	01010000000000000000C040C00000000000E86240	0102000000020000000000000000002440000000000000344000000000000026400000000000003540
R: 6	NULL	NULL	NULL
Q: SELECT id, ST_Distance(p, ST_GeomFromText('POINT(0 0)', ST_SRID(p))) FROM s WHERE ST_SRID(p) = 0 ORDER BY id;
R: 1	5
R: 2	7.0710678118654755
R: 3	15.811388300841896
Q: SELECT id, ST_Length(g) FROM s WHERE ST_GeometryType(g) = 'LINESTRING' AND ST_SRID(g) = 0 ORDER BY id;
R: 1	10
Q: SELECT id, ST_Area(g) FROM s WHERE ST_GeometryType(g) = 'POLYGON' ORDER BY id;
R: 2	100
R: 3	100
Q: SELECT id, ST_Contains(g, p), ST_Within(p, g) FROM s WHERE ST_GeometryType(g) = 'POLYGON' ORDER BY id;
R: 2	1	1
R: 3	0	0
Q: SELECT id, ST_IsEmpty(g), ST_Dimension(g), ST_NumPoints(g) FROM s WHERE ST_GeometryType(g) = 'LINESTRING' ORDER BY id;
R: 1	0	1	3
R: 5	0	1	2
Q: SELECT id, ST_AsText(ST_Envelope(g)), ST_AsText(ST_Centroid(g)) FROM s WHERE ST_SRID(g) = 0 ORDER BY id;
R: 1	POLYGON((0 0,6 0,6 4,0 4,0 0))	POINT(3 2)
R: 2	POLYGON((0 0,10 0,10 10,0 10,0 0))	POINT(5 5)
R: 3	POLYGON((0 0,10 0,10 10,0 10,0 0))	POINT(5 5)
Q: SELECT id, ST_AsText(ST_StartPoint(g)), ST_AsText(ST_EndPoint(g)) FROM s WHERE ST_GeometryType(g) = 'LINESTRING' ORDER BY id;
R: 1	POINT(0 0)	POINT(6 0)
R: 5	POINT(10 20)	POINT(11 21)
Q: SELECT ST_AsText(ST_GeomFromText('MULTIPOINT((1 2),(3 4))')), ST_AsText(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1))'));
R: MULTIPOINT((1 2),(3 4))	POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1))
Q: SELECT ST_AsText(POINT(1.5, -2.25)), ST_AsText(ST_GeomFromText('POINT(0.1 1e20)')), ST_AsText(ST_GeomFromText('POINT(123456789.123456789 -0.000001)'));
R: POINT(1.5 -2.25)	POINT(0.1 1e20)	POINT(123456789.12345679 -0.000001)
Q: SELECT ST_X(ST_GeomFromText('POINT(10 20)', 4326)), ST_Latitude(ST_GeomFromText('POINT(10 20)', 4326)), ST_Longitude(ST_GeomFromText('POINT(10 20)', 4326));
R: 10	10	20
Q: SELECT HEX(ST_GeomFromText('POINT(10 20)', 4326));
R: E6100000010100000000000000000034400000000000002440
Q: SELECT ST_Distance(ST_GeomFromText('POINT(0 0)'), ST_GeomFromText('LINESTRING(1 1, 2 0)'));
R: 1.4142135623730951
Q: SELECT ST_AsText(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,1 1))'));
R: GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,1 1))
Q: SELECT ST_Distance_Sphere(ST_GeomFromText('POINT(0 0)'), ST_GeomFromText('POINT(1 1)'));
R: 157249.0357231545
Q: SELECT MBRContains(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('POINT(1 1)')), ST_Intersects(ST_GeomFromText('LINESTRING(0 0,2 2)'), ST_GeomFromText('LINESTRING(0 2,2 0)'));
R: 1	1
Q: SELECT ST_GeometryType(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(1 1))')), ST_GeometryType(ST_GeomFromText('MULTIPOINT(1 1,2 2)'));
R: GEOMCOLLECTION	MULTIPOINT
Q: SELECT ST_AsText(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY')), ST_IsEmpty(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY')), ST_Dimension(ST_GeomFromText('GEOMETRYCOLLECTION EMPTY'));
R: GEOMETRYCOLLECTION EMPTY	1	NULL
Q: SELECT ST_IsClosed(ST_GeomFromText('POINT(1 1)'));
R: NULL
Q: SELECT ST_NumPoints(ST_GeomFromText('POINT(1 1)'));
R: NULL
Q: SELECT ST_NumGeometries(ST_GeomFromText('POINT(1 1)'));
R: NULL
Q: SELECT ST_Length(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 0))'));
R: NULL
Q: SELECT ST_Area(ST_GeomFromText('POINT(1 1)'));
R: execution error: POLYGON/MULTIPOLYGON value is a geometry of unexpected type POINT in st_area.
Q: SELECT ST_Area(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'));
R: 15
Q: SELECT ST_AsGeoJSON(ST_GeomFromText('POINT(3 4)')), ST_AsGeoJSON(ST_GeomFromText('POINT(10 20)', 4326));
R: {"type": "Point", "coordinates": [3.0, 4.0]}	{"type": "Point", "coordinates": [20.0, 10.0]}
Q: SELECT ST_AsGeoJSON(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 0))'));
R: {"type": "Polygon", "coordinates": [[[0.0, 0.0], [1.0, 0.0], [1.0, 1.0], [0.0, 0.0]]]}
Q: SELECT MBRContains(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('POINT(0 0)')), MBRContains(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('POINT(0 2)')), MBRWithin(ST_GeomFromText('POINT(1 1)'), ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))')), MBRIntersects(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('POLYGON((4 0,8 0,8 4,4 4,4 0))'));
R: 0	0	1	1
Q: SELECT ST_Contains(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('POINT(0 2)')), ST_Contains(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('LINESTRING(1 1,3 3)')), ST_Contains(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('LINESTRING(0 0,4 4)')), ST_Contains(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('LINESTRING(0 0,4 0)'));
R: 0	1	1	0
Q: SELECT ST_Contains(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('POLYGON((1 1,2 1,2 2,1 1))')), ST_Contains(ST_GeomFromText('LINESTRING(0 0,4 0)'), ST_GeomFromText('POINT(0 0)')), ST_Contains(ST_GeomFromText('LINESTRING(0 0,4 0)'), ST_GeomFromText('POINT(2 0)'));
R: 1	0	1
Q: SELECT ST_Distance(ST_GeomFromText('POINT(1 1)'), ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))')), ST_Distance(ST_GeomFromText('POINT(5 1)'), ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'));
R: 0	1
Q: SELECT ST_AsText(ST_Centroid(ST_GeomFromText('MULTIPOINT(0 0,2 2,4 0)'))), ST_AsText(ST_Centroid(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))')));
R: POINT(2 0.6666666666666666)	POINT(2.033333333333333 2.033333333333333)
Q: SELECT ST_AsText(ST_Envelope(ST_GeomFromText('POINT(1 2)'))), ST_AsText(ST_Envelope(ST_GeomFromText('LINESTRING(0 1,5 1)')));
R: POINT(1 2)	LINESTRING(0 1,5 1)
Q: SELECT ST_Distance(ST_GeomFromText('POINT(1 1)'), ST_GeomFromText('POINT(1 1)', 4326));
R: execution error: Binary geometry function st_distance given two geometries of different srids: 0 and 4326, which should have been identical.
Q: SELECT ST_GeomFromText('POINT(1)');
R: execution error: Invalid GIS data provided to function st_geomfromtext.
Q: SELECT ST_GeomFromText('POINT(100 0)', 4326);
R: execution error: Latitude 100.000000 is out of range in function st_geomfromtext. It must be within [-90.000000, 90.000000].
Q: SELECT ST_Latitude(ST_GeomFromText('POINT(1 1)'));
R: execution error: Function st_latitude is only defined for geographic spatial reference systems, but one of its arguments is in SRID 0, which is not geographic.
Q: SELECT ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING(0 0,1 1)'), 5)), ST_AsText(ST_PointN(ST_GeomFromText('LINESTRING(0 0,1 1)'), 2));
R: NULL	POINT(1 1)
Q: SELECT ST_X(ST_GeomFromText('LINESTRING(0 0,1 1)'));
R: execution error: POINT value is a geometry of unexpected type LINESTRING in st_x.
Q: SELECT ST_Distance_Sphere(ST_GeomFromText('POINT(10 20)', 4326), ST_GeomFromText('POINT(11 21)', 4326)), ST_Distance_Sphere(POINT(0,0), POINT(1,1), 1000);
R: 155941.42949668533	24.682056391766437
Q: SELECT ST_AsText(ST_GeomFromWKB(ST_AsBinary(ST_GeomFromText('POINT(10 20)', 4326)), 4326)), ST_AsText(ST_SRID(POINT(1, 2), 4326));
R: POINT(10 20)	POINT(2 1)
Q: SELECT ST_AsText(ST_GeomFromText('MULTILINESTRING((0 0,1 1),(2 2,3 3))')), ST_AsText(ST_GeomFromText('MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((2 2,3 2,3 3,2 2)))'));
R: MULTILINESTRING((0 0,1 1),(2 2,3 3))	MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((2 2,3 2,3 3,2 2)))
Q: SELECT ST_AsText(ST_GeomFromText('  point ( 1   2 ) ')), ST_AsText(ST_GeomFromText('LINESTRING(0 0,1 1,0 0)')), ST_IsClosed(ST_GeomFromText('LINESTRING(0 0,1 1,0 0)'));
R: POINT(1 2)	LINESTRING(0 0,1 1,0 0)	1
Q: SELECT ST_GeomFromText('LINESTRING(0 0)');
R: execution error: Invalid GIS data provided to function st_geomfromtext.
Q: SELECT ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1))');
R: execution error: Invalid GIS data provided to function st_geomfromtext.
Q: SELECT ST_NumInteriorRings(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))')), ST_AsText(ST_ExteriorRing(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'))), ST_AsText(ST_InteriorRingN(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 2,1 1))'), 1));
R: 1	LINESTRING(0 0,4 0,4 4,0 4,0 0)	LINESTRING(1 1,2 1,2 2,1 2,1 1)
Q: SELECT ST_NumGeometries(ST_GeomFromText('MULTIPOINT(1 1,2 2)')), ST_AsText(ST_GeometryN(ST_GeomFromText('MULTIPOINT(1 1,2 2)'), 2)), ST_Dimension(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,1 1))'));
R: 2	POINT(2 2)	1
Q: SELECT ST_Intersects(ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))'), ST_GeomFromText('POINT(4 4)')), ST_Disjoint(ST_GeomFromText('POINT(5 5)'), ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0))')), ST_Intersects(ST_GeomFromText('LINESTRING(0 0,1 0)'), ST_GeomFromText('LINESTRING(2 0,3 0)'));
R: 1	1	0
Q: SELECT ST_Within(ST_GeomFromText('POINT(1 1)'), ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 4,0 0),(0.5 0.5,1.5 0.5,1.5 1.5,0.5 1.5,0.5 0.5))'));
R: 0
Q: SELECT ST_AsText(ST_GeomFromText('POINT(-0 0.5)')), ST_AsText(POINT(1e16, 123.456e-20));
R: POINT(-0 0.5)	POINT(1e16 1.23456e-18)
